# Obsidian Bases view over the openspec/ artifact frontmatter.
# Seeded by `openspec-obsidian dashboard`; safe to customize by hand.
# Bases queries frontmatter only, so it complements openspec/dashboard.md
# (which carries the task-progress and requirement counts Bases cannot compute).
filters:
  and:
    - file.hasTag("openspec")
    - 'type != "dashboard"'
properties:
  type:
    displayName: Type
  change:
    displayName: Change
  capability:
    displayName: Capability
  file.mtime:
    displayName: Modified
views:
  - type: table
    name: All artifacts
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - change
      - capability
      - file.mtime
  - type: table
    name: Changes
    filters:
      and:
        - 'type == "proposal"'
    order:
      - file.name
      - change
      - file.mtime
  - type: table
    name: Specs
    filters:
      and:
        - 'type == "spec"'
    order:
      - file.name
      - capability
